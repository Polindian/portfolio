---
import { SITE } from '../config';
---
{SITE.trailerYouTubeId ? (
  <div class="trailer">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${SITE.trailerYouTubeId}`}
      title="Champions Arena trailer"
      loading="lazy"
      allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
    ></iframe>
  </div>
) : (
  <div class="placeholder">Trailer goes here: add the YouTube video ID in src/config.ts</div>
)}
<style>
  .trailer { position: relative; aspect-ratio: 16 / 9; }
  .trailer iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 1px solid var(--line); }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Trailer from '../components/Trailer.astro';
import { SITE } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
const link = (id: string) => `${base}/systems/${id}/`;

const stack = ['Unreal Engine 5 (source build)', 'C++ & Blueprints', 'Gameplay Ability System', 'Dedicated servers',
  'Epic Online Services', 'Steam', 'Python / Flask', 'SQLite', 'Docker', 'AWS EC2'];
---
<Base title="Champions Arena" description="Champions Arena — a multiplayer arena game built solo in Unreal Engine 5.">
  <section class="wrap" style="padding-top:2.5rem">
    <h1>Champions Arena</h1>
    <p class="lead">
      A team-based multiplayer arena game: pick a champion, fight through rounds, capture the flag,
      earn souls to upgrade abilities, and climb the leaderboard. Built solo in Unreal Engine 5.
    </p>
    <div>{stack.map((s) => <span class="tag">{s}</span>)}</div>
    {SITE.steam && <p style="margin-top:1rem"><a class="btn primary" href={SITE.steam}>Wishlist on Steam ↗</a></p>}
  </section>

  <section class="wrap" style="margin-top:2rem"><Trailer /></section>

  <section class="wrap">
    <h2>Architecture overview</h2>
    <p class="dim">How the pieces connect. Each box links to its deep dive.</p>
    <div class="arch">
      <div class="lane">
        <span class="lane-label">Player's PC</span>
        <a class="node" href={link('ui-architecture')}><b>UI</b><small>Menus, lobby, HUD</small></a>
        <a class="node" href={link('gameplay-framework')}><b>Client framework</b><small>GameInstance · PlayerController</small></a>
      </div>
      <div class="arrow">⇅ <small>replication · RPCs</small></div>
      <div class="lane">
        <span class="lane-label">Dedicated server</span>
        <a class="node" href={link('gameplay-framework')}><b>GameMode / GameState</b><small>Rounds, teams, match flow</small></a>
        <a class="node" href={link('gas-and-combat')}><b>GAS & Combat</b><small>Abilities, damage, upgrades</small></a>
        <a class="node" href={link('networking-and-replication')}><b>Networking</b><small>Authority, prediction</small></a>
        <a class="node" href={link('ai')}><b>AI</b><small>Behaviour trees</small></a>
        <a class="node" href={link('audio')}><b>Audio</b><small>Who hears what</small></a>
      </div>
      <div class="arrow">⇅ <small>HTTP · EOS sessions</small></div>
      <div class="lane">
        <span class="lane-label">Online services</span>
        <a class="node" href={link('online-backend')}><b>Steam + EOS</b><small>Login, sessions</small></a>
        <a class="node" href={link('online-backend')}><b>Flask coordinator</b><small>Spawns servers, stores stats</small></a>
        <a class="node" href={link('online-backend')}><b>Docker on AWS</b><small>Deployment</small></a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <h2>Gameplay features</h2>
    <p class="dim">TODO: add a short GIF for each.</p>
    <div class="grid">
      {['Hero selection', 'Melee combos', 'Light & heavy abilities', 'Flag capture rounds', 'Upgrades & skill tree',
        'Shop & consumables', 'AI skeleton enemies', 'Leaderboards'].map((f) => (
        <div class="card"><div class="placeholder" style="margin-bottom:0.8rem">GIF</div><h3>{f}</h3></div>
      ))}
    </div>
  </section>

  <section class="wrap">
    <h2>Deep dives</h2>
    <div class="grid">
      {systems.map((s) => (
        <a class="card" href={link(s.id)}><h3>{s.data.title}</h3><p>{s.data.summary}</p></a>
      ))}
    </div>
  </section>
</Base>

<style>
  .lead { font-size: 1.15rem; color: var(--text-dim); max-width: 46rem; }
  .dim { color: var(--text-dim); }
  .arch { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1.2rem; }
  .lane {
    position: relative; display: flex; flex-wrap: wrap; gap: 0.7rem;
    padding: 2rem 1rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-sunken);
  }
  .lane-label { position: absolute; top: 0.55rem; left: 1rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold); }
  .node {
    flex: 1 1 170px; display: flex; flex-direction: column; padding: 0.7rem 0.9rem;
    background: var(--bg-raised); border: 1px solid var(--line); border-radius: 8px; color: var(--text);
  }
  .node:hover { border-color: var(--gold); text-decoration: none; }
  .node small { color: var(--text-dim); }
  .arrow { text-align: center; color: var(--gold); }
  .arrow small { color: var(--text-dim); }
</style>

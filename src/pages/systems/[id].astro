---
import { getCollection, render } from 'astro:content';
import SystemPage from '../../layouts/SystemPage.astro';

export async function getStaticPaths() {
  const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
  return systems.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: systems[i - 1] && { id: systems[i - 1].id, title: systems[i - 1].data.title },
      next: systems[i + 1] && { id: systems[i + 1].id, title: systems[i + 1].data.title },
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---
<SystemPage {...entry.data} headings={headings} prev={prev} next={next}>
  <Content />
</SystemPage>
